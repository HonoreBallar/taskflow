# Copier ce fichier en .env puis renseigner les valeurs.
# Les trois secrets ci-dessous sont OBLIGATOIRES : docker compose refuse de démarrer s'ils sont vides.

POSTGRES_DB=taskflow
POSTGRES_USER=taskflow
# Mot de passe de la base (ex : openssl rand -hex 24)
POSTGRES_PASSWORD=

# Secret de signature des JWT : 64 caractères aléatoires minimum (ex : openssl rand -base64 64 | tr -d '\n')
# Quiconque connaît ce secret peut se faire passer pour n'importe quel utilisateur, administrateur compris.
JWT_SECRET=

# Compte administrateur créé au premier démarrage (base vide)
ADMIN_EMAIL=admin@taskflow.com
ADMIN_PASSWORD=

# Interface d'écoute du frontend : 0.0.0.0 (tout le réseau) ou 127.0.0.1 (cette machine uniquement)
FRONTEND_BIND=0.0.0.0
FRONTEND_PORT=80
# Ports publiés uniquement sur 127.0.0.1 (développement local)
BACKEND_PORT=8080
DB_PORT=5432
CORS_ORIGINS=http://localhost,http://localhost:4200
FRONTEND_URL=http://localhost

# ---- Emails : confirmation d'adresse à l'inscription, réinitialisation de mot de passe ----
# Sans SMTP_HOST, aucun email ne part : les nouveaux inscrits ne peuvent pas activer leur compte
# (un administrateur peut toujours créer des comptes depuis l'interface).
EMAIL_VERIFICATION=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=no-reply@taskflow.local

# ---- HTTPS (docker-compose.https.yml) ----
# Domaine public de l'application ; le certificat est obtenu automatiquement.
DOMAIN=
# Sans la surcouche HTTPS mais derrière votre propre proxy TLS : passer COOKIE_SECURE à true.
COOKIE_SECURE=false

# ---- Options de développement : laisser à false en production ----
# Crée les comptes de démonstration du README (mots de passe publics) au premier démarrage
SEED_DEMO=false
# Expose Swagger UI et /v3/api-docs
SWAGGER_ENABLED=false
# Écrit dans les logs du backend les liens envoyés par email (confirmation, réinitialisation)
LOG_RESET_LINKS=false
